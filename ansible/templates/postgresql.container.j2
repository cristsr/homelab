[Unit]
Description=PostgreSQL data engine

[Container]
# trixie variant: the data was initialised on postgres:17 (Debian trixie, glibc 2.41); the default
# pgvector tag is bookworm (glibc 2.36) and would break text-index collation.
Image=docker.io/pgvector/pgvector:pg17-trixie
Volume=/srv/postgresql:/var/lib/postgresql/data:U,Z
Network=host
AutoUpdate=registry
Environment=POSTGRES_USER={{ postgresql_app_username }}
Environment=POSTGRES_PASSWORD={{ postgresql_app_password }}
Environment=POSTGRES_DB=homelab

[Service]
Restart=always

[Install]
WantedBy=multi-user.target podman-auto-update.timer
