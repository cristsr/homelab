[Unit]
Description=Qdrant data engine

[Container]
Image=docker.io/qdrant/qdrant:v1.12.4
Volume=/srv/qdrant:/qdrant/storage:U,Z
Network=host
AutoUpdate=registry
Environment=QDRANT__SERVICE__API_KEY={{ qdrant_api_key }}

[Service]
Restart=always

[Install]
WantedBy=multi-user.target podman-auto-update.timer
