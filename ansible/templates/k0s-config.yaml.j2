apiVersion: k0s.k0sproject.io/v1beta1
kind: ClusterConfig
metadata:
  name: k0s
spec:
  api:
    address: {{ k0s_node_ip }}
    sans:
      - {{ k0s_node_ip }}
      - 127.0.0.1
  network:
    provider: custom
    podCIDR: "{{ k0s_pod_cidr }}"
    serviceCIDR: "{{ k0s_service_cidr }}"
    kubeProxy:
      disabled: true
