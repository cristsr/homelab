# ansible/extra-secrets.yaml.example
# This file is documentation only.
# Copy to extra-secrets.yaml and fill in your values.
# The extra-secrets.yaml file must NEVER be committed (it is in .gitignore).
#
# Structure:
#   - path:    OpenBao KV v2 path (without the 'secret/data/' prefix)
#   - data:    Key-value map to store under that path.
#              You can group multiple keys under the same path.
#
# The following entries cover all ExternalSecrets not populated by vault-populate.yaml.
# Leave values empty if you are not using the corresponding application.

openbao_extra_secrets:
  # --- Databases ---
  - path: databases/redis
    data:
      redis-password: ""

  - path: databases/qdrant
    data:
      api_key: ""

  - path: databases/postgresql-app
    data:
      username: ""
      password: ""

  - path: databases/mongodb-app
    data:
      password: ""

  # --- Monitoring ---
  - path: monitoring/grafana
    data:
      username: "admin"
      password: ""

  # --- DevTools ---
  - path: devtools/openmemory
    data:
      OPENAI_API_KEY: ""

  - path: devtools/sonarqube
    data:
      password: ""

  # --- Apps ---
  - path: apps/flow
    data:
      database-url: ""
      mongodb-url: ""
      redis-url: ""
