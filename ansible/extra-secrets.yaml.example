# ansible/extra-secrets.yaml.example
# Este archivo es solo documentacion.
# Copia a extra-secrets.yaml y ajusta los valores.
# El archivo extra-secrets.yaml NUNCA debe versionarse (esta en .gitignore).
#
# Estructura:
#   - path:    Ruta en OpenBao KV v2 (sin el prefijo 'secret/data/')
#   - data:    Mapa de clave-valor que se almacenara en ese path.
#              Puedes agrupar multiples claves bajo el mismo path.

openbao_extra_secrets:
  - path: ejemplo/app
    data:
      api_key: "cambia_esto"

  - path: monitoring/grafana
    data:
      admin_user: "admin"
      admin_password: "cambia_esto"

  - path: data-platform/postgres
    data:
      superuser_password: "cambia_esto"
      replication_password: "cambia_esto"
