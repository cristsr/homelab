# secrets/homelab.env.example
#
# Copiar a secrets/homelab.env y completar los valores reales. Ese archivo
# NUNCA se commitea (esta en .gitignore).
#
# Los secrets de la aplicacion (GHCR_PAT, ARGOCD_WEBHOOK_SECRET,
# CLOUDFLARE_API_TOKEN, CLOUDFLARED_TOKEN, GRAFANA_*, etc.) viven en
# 1Password (vault "Homelab") - este archivo ya no los carga a ningun lado,
# se cargan a mano en 1Password o via scripts/migrate-openbao-to-1password.sh.
#
# Lo que sigue consumiendo este archivo:
#   - ansible/preflight.yaml: exportarlo (`set -a; source
#     secrets/homelab.env; set +a`) antes de `ansible-playbook preflight.yaml`
#     (solo usa ARGOCD_GITHUB_PAT/ARGOCD_REPO_URL).
#   - ansible/data-services.yaml: credenciales de los motores de datos en
#     sus LXC (seccion Databases de abajo).
#
# Los campos de Infra son obligatorios (Terraform/ArgoCD/preflight dependen
# de ellos). Los de Databases son obligatorios para levantar los motores en
# sus LXC. El resto queda documentado acá solo como referencia de qué
# secrets existen en 1Password - no hace falta completarlos en este archivo.

# --- Infra (obligatorios) ---
ARGOCD_GITHUB_USERNAME=cristsr
ARGOCD_REPO_URL=https://github.com/cristsr/homelab
ARGOCD_GITHUB_PAT=
# PAT con read:packages para la imagen privada de GHCR (ghcr.io/cristsr).
# Puede ser el mismo PAT de arriba si tiene ambos scopes.
GHCR_PAT=
ARGOCD_WEBHOOK_SECRET=
CLOUDFLARE_API_TOKEN=
CLOUDFLARED_TOKEN=

# --- Databases (obligatorios, usados por ansible/data-services.yaml) ---
REDIS_PASSWORD=
QDRANT_API_KEY=
POSTGRESQL_APP_USERNAME=
POSTGRESQL_APP_PASSWORD=
MONGODB_APP_PASSWORD=

# --- Monitoring ---
GRAFANA_ADMIN_USERNAME=admin
GRAFANA_ADMIN_PASSWORD=

# --- SonarQube ---
SONARQUBE_DB_USERNAME=sonarqube
SONARQUBE_DB_PASSWORD=
SONARQUBE_MONITORING_PASSCODE=

# --- DevTools ---
OPENMEMORY_OPENAI_API_KEY=

# --- Apps ---
FLOW_DATABASE_URL=
FLOW_MONGODB_URL=
FLOW_REDIS_URL=
