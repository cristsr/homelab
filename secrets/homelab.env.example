# secrets/homelab.env.example
#
# Copiar a secrets/homelab.env y completar los valores reales. Ese archivo
# NUNCA se commitea (esta en .gitignore) - son valores en texto plano.
#
# Consumidores:
#   - ansible/preflight.yaml: exportarlo (`set -a; source
#     secrets/homelab.env; set +a`) antes de `ansible-playbook preflight.yaml`
#     (solo usa ARGOCD_GITHUB_PAT/ARGOCD_REPO_URL).
#   - scripts/apply-real-secrets.sh: toma este archivo (o una copia) como
#     argumento y carga cada valor en el SopsSecret/`.env` cifrado que
#     corresponda (`sops set`, campo por campo - nunca reescribe un archivo
#     entero salvo ansible/data-services.env, que es dotenv plano). Cualquier
#     campo vacio se omite, el valor cifrado existente queda intacto.
#
# Los campos de Infra son obligatorios (Terraform/ArgoCD/preflight dependen
# de ellos). El resto son los que hoy tienen un placeholder "admin" en el
# repo (ver ADR-018/019 en docs/DECISIONS.md) - completalos para que
# cloudflared, SonarQube y Grafana dejen de fallar.
#
# IMPORTANTE sobre POSTGRESQL_APP_PASSWORD/MONGODB_APP_PASSWORD: el
# contenedor de postgres/mongo solo aplica esa password la primera vez que
# arranca sobre un volumen vacio. Si ya corrieron antes (como ahora, con
# "admin"), cambiar este archivo y volver a desplegar NO les cambia la
# password real - hay que hacerlo a mano (ALTER USER/ALTER ROLE) o borrar
# /srv/postgresql y /srv/mongodb en la LXC para que se reinicialicen. redis
# recoge el valor nuevo en cada restart, sin este problema.

# --- Infra (obligatorios) ---
ARGOCD_GITHUB_USERNAME=cristsr
ARGOCD_REPO_URL=https://github.com/cristsr/homelab
ARGOCD_GITHUB_PAT=
CLOUDFLARE_API_TOKEN=
CLOUDFLARED_TUNNEL_TOKEN=

# --- Databases (usados por ansible/data-services.yaml via data-services.env) ---
REDIS_PASSWORD=
POSTGRESQL_APP_USERNAME=admin
POSTGRESQL_APP_PASSWORD=
MONGODB_APP_PASSWORD=

# --- Monitoring ---
GRAFANA_ADMIN_USERNAME=admin
GRAFANA_ADMIN_PASSWORD=

# --- SonarQube ---
# SONARQUBE_DB_USERNAME/PASSWORD tienen que coincidir con el rol que crea
# ansible/data-services.yaml en PostgreSQL - scripts/apply-real-secrets.sh
# ya lo garantiza (usa estos mismos dos valores para ambos lados).
SONARQUBE_DB_USERNAME=sonarqube
SONARQUBE_DB_PASSWORD=
SONARQUBE_MONITORING_PASSCODE=

# --- DevTools ---

# --- Hindsight (agent memory) ---
# HINDSIGHT_DB_USERNAME/PASSWORD: rol y password de la base `hindsight` en
# PostgreSQL. scripts/apply-real-secrets.sh usa los mismos dos valores para
# Ansible (crea el rol) y para la URL de conexion del pod.
# HINDSIGHT_OPENROUTER_API_KEY: una sola key de OpenRouter sirve para el LLM y
# para los embeddings.
# HINDSIGHT_API_KEY: exigida en cada request (incluido MCP). Generar con
# `openssl rand -base64 32`; es el bearer que usa Claude Code.
HINDSIGHT_DB_USERNAME=hindsight
HINDSIGHT_DB_PASSWORD=
HINDSIGHT_OPENROUTER_API_KEY=
HINDSIGHT_API_KEY=
# HINDSIGHT_CP_ACCESS_KEY: clave para entrar al panel web de Hindsight. El panel usa
# HINDSIGHT_API_KEY por detras, asi que quien entra tiene acceso total: que sea larga
# (`openssl rand -hex 32`) y distinta de la de la API.
HINDSIGHT_CP_ACCESS_KEY=

# --- Vikunja (task management) ---
# VIKUNJA_DB_USERNAME/PASSWORD: rol y password de la base `vikunja` en
# PostgreSQL. scripts/apply-real-secrets.sh usa los mismos dos valores para
# Ansible (crea el rol) y para el secret del pod.
# VIKUNJA_JWT_SECRET: firma los tokens de sesion. Generar con `openssl rand -hex 32`.
VIKUNJA_DB_USERNAME=vikunja
VIKUNJA_DB_PASSWORD=
VIKUNJA_JWT_SECRET=

# --- Kaneo (task management) ---
# KANEO_DB_USERNAME/PASSWORD: rol y password de la base `kaneo` en PostgreSQL.
# scripts/apply-real-secrets.sh usa los mismos dos valores para Ansible (crea
# el rol) y para el secret del pod.
# KANEO_AUTH_SECRET: firma las sesiones; minimo 32 caracteres. Generar con
# `openssl rand -hex 32`.
KANEO_DB_USERNAME=kaneo
KANEO_DB_PASSWORD=
KANEO_AUTH_SECRET=

# --- Opcional, sin consumidor real hoy (no bloquea nada) ---
# `flow` es un stub (traefik/whoami, workloads/flow/deployment.yaml) que
# todavia no lee este secret.
FLOW_DATABASE_URL=
FLOW_MONGODB_URL=
FLOW_REDIS_URL=
