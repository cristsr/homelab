# secrets/homelab.env.example
#
# Copiar a secrets/homelab.env y completar los valores reales. Ese archivo
# NUNCA se commitea (esta en .gitignore).
#
# Consumido por dos cosas:
#   - scripts/load-secrets-to-openbao.sh: carga todo esto en OpenBao KV.
#   - ansible/preflight.yaml: exportar este archivo (`set -a; source
#     secrets/homelab.env; set +a`) antes de `ansible-playbook preflight.yaml`,
#     valida los 6 campos de infra antes de correr `terraform apply`.
#
# Los campos de Infra son obligatorios (Terraform/ArgoCD/preflight dependen
# de ellos). Los de Databases/Monitoring/DevTools/Apps son opcionales -
# vacio significa "esa app/servicio no esta en uso todavia".

# --- Infra (obligatorios) ---
ARGOCD_GITHUB_USERNAME=cristsr
ARGOCD_REPO_URL=https://github.com/cristsr/homelab
ARGOCD_GITHUB_PAT=
ARGOCD_WEBHOOK_SECRET=
CLOUDFLARE_API_TOKEN=
CLOUDFLARED_TOKEN=
OPENBAO_STATIC_SEAL_KEY=

# --- Databases ---
REDIS_PASSWORD=
QDRANT_API_KEY=
POSTGRESQL_APP_USERNAME=
POSTGRESQL_APP_PASSWORD=
MONGODB_APP_PASSWORD=

# --- Monitoring ---
GRAFANA_ADMIN_USERNAME=admin
GRAFANA_ADMIN_PASSWORD=

# --- SonarQube ---
SONARQUBE_DB_USERNAME=sonarqube
SONARQUBE_DB_PASSWORD=
SONARQUBE_MONITORING_PASSCODE=

# --- DevTools ---
OPENMEMORY_OPENAI_API_KEY=

# --- Apps ---
FLOW_DATABASE_URL=
FLOW_MONGODB_URL=
FLOW_REDIS_URL=
