variable "kubeconfig_path" {
  description = "Path to the kubeconfig generated by terraform/infra"
  type        = string
}

variable "argocd_github_username" {
  description = "GitHub username of the repo ArgoCD syncs from"
  type        = string
  default     = "cristsr"
}

variable "argocd_github_pat" {
  description = "GitHub Personal Access Token with access to the ArgoCD repo"
  type        = string
  sensitive   = true
}
