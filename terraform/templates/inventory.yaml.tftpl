# Generado por `terraform apply` (terraform/main.tf, resource local_file.ansible_inventory)
# No editar a mano - se sobreescribe en cada apply.
all:
  children:
    k0s:
      hosts:
        homelab:
          ansible_host: ${vm_ip}
          ansible_user: ${ssh_user}
          ansible_connection: ssh
          ansible_ssh_private_key_file: ${ssh_key_path}
          # La VM vive en la red NAT interna de libvirt, solo alcanzable
          # desde el propio hipervisor: saltamos por SSH a traves de el.
          ansible_ssh_common_args: '-o ProxyCommand="ssh -i ${hypervisor_keyfile} -W %h:%p -o StrictHostKeyChecking=no ${hypervisor_user}@${hypervisor_host}"'
    hypervisor:
      hosts:
        homelab-host:
          ansible_host: ${hypervisor_host}
          ansible_user: ${hypervisor_user}
          ansible_connection: ssh
          ansible_ssh_private_key_file: ${hypervisor_keyfile}
