# Copiar a terraform.tfvars (gitignored) y completar.

# Ajustar si hace falta; estos son los defaults ya definidos en variables.tf
# vm_name          = "talos"
# vm_id            = 100
# memory_mib       = 20480
# vcpu             = 8
# disk_size_gb     = 120
# zfs_disk_size_gb = 100
# media_disk_size_gb = 1024
# proxmox_datastore_id = "local-lvm"
# network_bridge   = "vmbr0"
# talos_version      = "v1.14.0"
# talos_schematic_id = "42dcbb7542e7f2d53beec866d4687f9306cd2b2da3b049fb4872cfc41942723e"
# cluster_name       = "talos"

# Contenedores LXC de datos (lxc.tf): valores fijos en el locals
# data_services, sin variables propias. Las IPs asignadas tambien salen en
# `terraform output data_service_ips`.
#   postgresql  vmid 121  IP 10.10.20.10  1024 MiB  1 core  15 GB
#   mongodb     vmid 122  IP 10.10.20.20  1024 MiB  1 core  10 GB
#   redis       vmid 124  IP 10.10.20.40   512 MiB  1 core   5 GB
#   mysql       vmid 125  IP 10.10.20.50  1024 MiB  1 core  15 GB

# Obligatorias, sin default a proposito. En CI se inyectan por TF_VAR_*.
# proxmox_endpoint  = "https://192.168.80.20:8006/"
# proxmox_api_token = "terraform@pve!ci=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# vm_static_ip      = "192.168.80.30"
# vm_gateway        = "192.168.80.1"
